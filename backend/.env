# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
DB_HOST=db.your_project_ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=true

# Firebase Admin SDK
FIREBASE_PROJECT_ID=svaraverse-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@svaraverse-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=svaraverse-app.appspot.com
FIREBASE_DATABASE_URL=https://svaraverse-app.firebaseio.com

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key-here

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token-here
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRES_IN=30d

# Email (for verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@svaraverse.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM=SvaraVerse <noreply@svaraverse.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Logging
LOG_LEVEL=debug
